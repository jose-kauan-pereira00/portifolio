---
// src/components/Experiences.astro
---
<section id="experiences" class="relative text-white min-h-screen flex flex-col justify-center py-20 px-6 overflow-hidden scroll-mt-24">
  
  <!-- Título Principal da Seção -->
  <div class="max-w-4xl mx-auto w-full mb-12">
    <h2 class="text-4xl font-bold border-b-4 border-amber-400 inline-block pb-1">Experiences</h2>
  </div>

  <!-- Container da Timeline -->
  <div class="max-w-4xl mx-auto w-full flex flex-col gap-8 relative border-l-2 border-neutral-800 pl-6 ml-2 md:ml-auto">
    
    <!-- ================= 1ª EXPERIÊNCIA (REPLICÁVEL) ================= -->
    <div class="relative group">
      <!-- Ponto indicador na linha -->
      <div class="absolute -left-[31px] top-1.5 w-4 h-4 rounded-full bg-amber-400 border-4 border-neutral-950"></div>
      
      <div class="bg-neutral-900/50 border border-neutral-800 p-6 rounded-xl transition-all duration-300 hover:border-amber-400/50 hover:bg-neutral-900">
        <span class="text-xs font-semibold text-amber-400 tracking-wider uppercase">2023 - Presente</span>
        <h3 class="text-2xl font-bold text-white mt-1">Desenvolvedor Backend / Fullstack</h3>
        <p class="text-sm text-gray-400 mb-3">Nome da Empresa ou Projetos Pessoais</p>
        <p class="text-gray-300 text-sm leading-relaxed mb-4">
          Desenvolvimento de APIs robustas utilizando Java, Spring Boot e Spring Security, com controle de autenticação OAuth2 e persistência de dados relacional.
        </p>
        <div class="flex flex-wrap gap-2">
          <span class="px-2.5 py-1 text-xs bg-amber-400/10 text-amber-400 rounded-md border border-amber-400/20">Java</span>
          <span class="px-2.5 py-1 text-xs bg-amber-400/10 text-amber-400 rounded-md border border-amber-400/20">Spring Boot</span>
          <span class="px-2.5 py-1 text-xs bg-amber-400/10 text-amber-400 rounded-md border border-amber-400/20">MySQL</span>
        </div>
      </div>
    </div>
    <!-- ================= FIM DA EXPERIÊNCIA 1 ================= -->


    <!-- ================= 2ª EXPERIÊNCIA (REPLICÁVEL) ================= -->
    <div class="relative group">
      <div class="absolute -left-[31px] top-1.5 w-4 h-4 rounded-full bg-amber-400 border-4 border-neutral-950"></div>
      
      <div class="bg-neutral-900/50 border border-neutral-800 p-6 rounded-xl transition-all duration-300 hover:border-amber-400/50 hover:bg-neutral-900">
        <span class="text-xs font-semibold text-amber-400 tracking-wider uppercase">2021 - 2023</span>
        <h3 class="text-2xl font-bold text-white mt-1">Desenvolvedor Frontend</h3>
        <p class="text-sm text-gray-400 mb-3">Freelancer / Projetos Web</p>
        <p class="text-gray-300 text-sm leading-relaxed mb-4">
          Criação de interfaces modernas, responsivas e de alta performance utilizando Astro, Tailwind CSS e foco em otimização de experiência de usuário (UI/UX).
        </p>
        <div class="flex flex-wrap gap-2">
          <span class="px-2.5 py-1 text-xs bg-amber-400/10 text-amber-400 rounded-md border border-amber-400/20">Astro</span>
          <span class="px-2.5 py-1 text-xs bg-amber-400/10 text-amber-400 rounded-md border border-amber-400/20">Tailwind CSS</span>
          <span class="px-2.5 py-1 text-xs bg-amber-400/10 text-amber-400 rounded-md border border-amber-400/20">JavaScript</span>
        </div>
      </div>
    </div>
    <!-- ================= FIM DA EXPERIÊNCIA 2 ================= -->

  </div>
</section>