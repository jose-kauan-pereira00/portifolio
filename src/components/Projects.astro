---
---
<section id="projects" class="relative text-white min-h-screen flex flex-col justify-center py-20 px-6 overflow-hidden scroll-mt-24">
  
  <div class="max-w-6xl mx-auto w-full mb-10 text-center md:text-left">
    <h2 class="text-4xl font-bold border-b-4 border-amber-400 inline-block pb-1 hidden md:block">Projects</h2>
  </div>

  <div class="max-w-6xl mx-auto w-full flex flex-col gap-14 ">
    
    <div class="w-full">
      <h3 class="text-2xl font-semibold text-amber-400 mb-6 border-l-4 border-amber-400 pl-3">
        Front-end Projects
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        <div class="group relative h-[460px] rounded-xl overflow-hidden shadow-xl bg-cover bg-center transition-transform duration-300 hover:scale-[1.02]" 
             style="background-image: url('/images/code-flix.png');">
          
          <div class="absolute inset-0 bg-black/20 group-hover:bg-black/85 transition-all duration-300 flex flex-col justify-end p-6">
            <span class="text-xs uppercase tracking-wider text-amber-600 font-semibold mb-1">React / Tailwind</span>

            <h4 class="text-xl font-bold text-white group-hover:text-amber-400 transition-colors duration-300 mb-2">
              Netflix Clone
            </h4>
            <p class="text-gray-300 text-sm leading-relaxed mb-4 opacity-90 group-hover:opacity-100 transition-opacity duration-300">
              Clone the Netflix website using React and Tailwind
            </p>
            <a href="https://github.com/jose-kauan-pereira00/codeflix-client" target="_blank" class="inline-flex items-center gap-2 text-sm font-semibold text-amber-400 hover:text-white transition-colors">
            View Code &rarr;
            </a>
            <a href="https://codeflix-client-liard.vercel.app/" target="_blank" class="inline-flex items-center gap-2 text-sm font-semibold text-white hover:text-amber-400 transition-colors">
              View page &rarr;
            </a>
          </div>
        </div>

        <div class="group relative h-[460px] rounded-xl overflow-hidden shadow-xl bg-cover bg-center transition-transform duration-300 hover:scale-[1.02]" 
             style="background-image: url('/images/castanha.png');">
          
          <div class="absolute inset-0 bg-black/70 group-hover:bg-black/85 transition-all duration-300 flex flex-col justify-end p-6">
            <span class="text-xs uppercase tracking-wider text-amber-600 font-semibold mb-1">Astro / Tailwind</span>

            <h4 class="text-xl text-left font-bold text-white group-hover:text-amber-400 transition-colors duration-300 mb-2">
              Nut Sales Page
            </h4>
            <p class="text-gray-300 text-sm leading-relaxed mb-4 opacity-90 group-hover:opacity-100 transition-opacity duration-300">
              Sales page for nuts. Following the client's specifications.
            </p>
            <a href="https://github.com/jose-kauan-pereira00/pag-venda-castanha" target="_blank" class="inline-flex items-center gap-2 text-sm font-semibold text-amber-400 hover:text-white transition-colors">
            View Code &rarr;
            </a>
            <a href="https://castanhadodaniel.vercel.app/" target="_blank" class="inline-flex items-center gap-2 text-sm font-semibold text-white hover:text-amber-400 transition-colors">
              View page &rarr;
            </a>
          </div>
        </div>


      </div>
    </div>


    <!-- ================= SUBSEÇÃO: BACK-END ================= -->
    <div class="w-full">
      <h3 class="text-2xl font-semibold text-amber-400 mb-6 border-l-4 border-amber-400 pl-3">
        Back-end Projects
      </h3>

      <!-- Grid de Projetos Back-end -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        <!-- 1º Projeto Back-end (Replicável) -->
        <div class="group relative h-[460px] rounded-xl overflow-hidden shadow-xl bg-cover bg-center transition-transform duration-300 hover:scale-[1.02]" 
             style="background-image: url('https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?q=80&w=800&auto=format&fit=crop');">
          
          <!-- ATENÇÃO AQUI: Mudou de bg-black/50 para bg-transparent -->
          <div class="absolute inset-0 bg-transparent group-hover:bg-black/85 transition-all duration-300 flex flex-col justify-end p-6">
            <span class="text-xs uppercase tracking-wider text-amber-400 font-semibold mb-1">Node.js / Express / API</span>
            <h4 class="text-xl font-bold text-white group-hover:text-amber-400 transition-colors duration-300 mb-2">
              API RESTful Segura
            </h4>
            <p class="text-gray-300 text-sm leading-relaxed mb-4 opacity-90 group-hover:opacity-100 transition-opacity duration-300">
              Arquitetura limpa, autenticação JWT e integração com banco de dados relacional.
            </p>
            <a href="https://github.com" target="_blank" class="inline-flex items-center gap-2 text-sm font-semibold text-amber-400 hover:text-amber-300 transition-colors">
              Ver Código &rarr;
            </a>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>